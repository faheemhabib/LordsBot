@LordsBot.ZipUpload_HostAddress = http://localhost:5268

# Health check endpoint
GET {{LordsBot.ZipUpload_HostAddress}}/api/health
Accept: application/json

###

# Upload zip file endpoint (use with REST Client extension in VS Code)
# Note: Replace the file path with your actual zip file path
POST {{LordsBot.ZipUpload_HostAddress}}/api/upload/zip
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="test.zip"
Content-Type: application/zip

< /path/to/your/test.zip
------WebKitFormBoundary7MA4YWxkTrZu0gW--

###

